# Documentation template only. The app does NOT load .env files automatically.
# Set these variables in the server process environment before launch.
# Keep real values out of source control. Empty values use local-only features.
# GPT model is fixed in backend/config.py: gpt-5-mini. HTTP port remains 8099.
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=
# Set to true only when Slack delivery is explicitly wanted.
SLACK_ALERTS_ENABLED=
